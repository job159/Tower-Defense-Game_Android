<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: glowing cyan hexagon bastion guarding a magenta crystal core.
  Glow is faked with stacked strokes of decreasing alpha. Everything stays inside the
  66dp safe circle (outermost node glow reaches radius ~31.5 around 54,54).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.08"
        android:scaleY="1.08">

        <!-- Magenta aura behind the core -->
        <path android:pathData="M33,54a21,21 0,1 0,42 0a21,21 0,1 0,-42 0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:centerX="54"
                    android:centerY="54"
                    android:gradientRadius="21"
                    android:type="radial">
                    <item android:color="#8CFF3DCB" android:offset="0" />
                    <item android:color="#00FF3DCB" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Hexagon ring: wide faint glow, mid glow, solid core, hot white center line -->
        <path
            android:pathData="M54,28L76.52,41L76.52,67L54,80L31.48,67L31.48,41Z"
            android:strokeWidth="7"
            android:strokeAlpha="0.12"
            android:strokeColor="#22E6FF"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M54,28L76.52,41L76.52,67L54,80L31.48,67L31.48,41Z"
            android:strokeWidth="4"
            android:strokeAlpha="0.28"
            android:strokeColor="#22E6FF"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M54,28L76.52,41L76.52,67L54,80L31.48,67L31.48,41Z"
            android:strokeWidth="2"
            android:strokeColor="#22E6FF" />
        <path
            android:pathData="M54,28L76.52,41L76.52,67L54,80L31.48,67L31.48,41Z"
            android:strokeWidth="0.7"
            android:strokeAlpha="0.9"
            android:strokeColor="#DDFCFF" />

        <!-- Inner segmented ring -->
        <path
            android:pathData="M57.38,36.45L67.51,42.3M70.89,48.15L70.89,59.85M67.51,65.7L57.38,71.55M50.62,71.55L40.49,65.7M37.11,59.85L37.11,48.15M40.49,42.3L50.62,36.45"
