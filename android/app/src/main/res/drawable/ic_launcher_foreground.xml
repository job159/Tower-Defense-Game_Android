            android:strokeAlpha="0.55"
            android:strokeColor="#22E6FF"
            android:strokeLineCap="round" />

        <!-- Vertex nodes: glow + bright core -->
        <path
            android:fillAlpha="0.35"
            android:fillColor="#22E6FF"
            android:pathData="M50.8,28a3.2,3.2 0,1 0,6.4 0a3.2,3.2 0,1 0,-6.4 0M73.32,41a3.2,3.2 0,1 0,6.4 0a3.2,3.2 0,1 0,-6.4 0M73.32,67a3.2,3.2 0,1 0,6.4 0a3.2,3.2 0,1 0,-6.4 0M50.8,80a3.2,3.2 0,1 0,6.4 0a3.2,3.2 0,1 0,-6.4 0M28.28,67a3.2,3.2 0,1 0,6.4 0a3.2,3.2 0,1 0,-6.4 0M28.28,41a3.2,3.2 0,1 0,6.4 0a3.2,3.2 0,1 0,-6.4 0" />
        <path
            android:fillColor="#E8FEFF"
            android:pathData="M52.5,28a1.5,1.5 0,1 0,3 0a1.5,1.5 0,1 0,-3 0M75.02,41a1.5,1.5 0,1 0,3 0a1.5,1.5 0,1 0,-3 0M75.02,67a1.5,1.5 0,1 0,3 0a1.5,1.5 0,1 0,-3 0M52.5,80a1.5,1.5 0,1 0,3 0a1.5,1.5 0,1 0,-3 0M29.98,67a1.5,1.5 0,1 0,3 0a1.5,1.5 0,1 0,-3 0M29.98,41a1.5,1.5 0,1 0,3 0a1.5,1.5 0,1 0,-3 0" />

        <!-- Crystal glow: two enlarged diamonds of decreasing alpha -->
