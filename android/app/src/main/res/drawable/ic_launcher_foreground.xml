        <path
            android:fillColor="#FFA6EC"
            android:pathData="M54,40L46.5,51.5L54,51.5Z" />
        <path
            android:fillColor="#FF3DCB"
            android:pathData="M54,40L61.5,51.5L54,51.5Z" />
        <path
            android:fillColor="#C81E9E"
            android:pathData="M46.5,51.5L54,68L54,51.5Z" />
        <path
            android:fillColor="#850C66"
            android:pathData="M61.5,51.5L54,68L54,51.5Z" />

        <!-- Crystal edge + specular highlight -->
        <path
            android:pathData="M54,40L61.5,51.5L54,68L46.5,51.5Z"
            android:strokeWidth="0.6"
            android:strokeAlpha="0.9"
            android:strokeColor="#FFD6F5"
            android:strokeLineJoin="round" />
        <path
