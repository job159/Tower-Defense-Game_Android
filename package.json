{
  "name": "neon-bastion",
  "version": "2.3.0",
  "private": true,
  "description": "霓虹防線 NEON BASTION - 3D sci-fi tower defense for Android (WebView) and browsers",
  "license": "MIT",
  "homepage": "https://job159.github.io/Tower-Defense-Game_Android/",
  "repository": {
    "type": "git",
    "url": "https://github.com/job159/Tower-Defense-Game_Android.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "build": "npm run build:web && npm run build:apk",
    "serve": "node scripts/serve.mjs",
    "sim": "node tools/simulate.mjs",
    "build:site": "node scripts/build-site.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "qrcode": "^1.5.4",
    "three": "^0.186.1"
  }
